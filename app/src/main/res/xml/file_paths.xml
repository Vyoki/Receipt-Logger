<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Saved originals, shared read-only with viewer apps via "Open original". -->
    <files-path name="documents" path="documents/" />
    <!-- Temporary photos written by the camera app before they are imported. -->
    <cache-path name="captures" path="captures/" />
    <!-- Files the operator explicitly shares (operation log). -->
    <cache-path name="shared" path="shared/" />
</paths>
