<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No runtime permissions are requested:
      - Photos are taken by the system camera app (ACTION_IMAGE_CAPTURE) into a file we own,
        which needs no CAMERA permission as long as this app does not declare it.
      - Images and PDFs are imported through the system document picker (Storage Access Framework),
        which needs no storage permission.
      - No INTERNET permission: OCR runs on the device with the bundled ML Kit model.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Background reading: documents keep being read (OCR + the on-phone AI) while the operator uses other
      screens or apps. A foreground service with a visible notification keeps the app alive meanwhile.
      Notifications say when a document is ready to check or was saved.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Security: what is on this phone stays on this phone.
      Libraries (e.g. ML Kit usage statistics) may ask for network access through manifest merging;
      these lines strip it, so Android itself blocks every network connection from this app.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Lets us check whether a camera app is installed (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".KitchenReceiptsApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KitchenReceipts">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              "Open with" / "Share to" Kitchen Receipts from mail, files or the gallery: PDFs, photos and e-invoices
              (.xml, signed .p7m, .zip). The file is copied into the app and read on the phone like any import.
              Mail apps often label a .p7m as binary, so sharing also accepts that (opening does not, to stay out of
              the way for other files).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs7-mime" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs7-mime" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".jobs.ReadingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
